# =============================================================================
# .gitignore — backend
# =============================================================================

# Dependencies
node_modules/

# Build output
dist/
build/

# Environment — NEVER commit .env
.env
.env.local
.env.*.local

# Prisma generated client (regenerated by `prisma generate`)
# Keep schema.prisma but ignore the generated JS/TS output inside node_modules
# (already covered above, but explicit for clarity)

# Coverage reports
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*

# OS artefacts
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# TypeScript incremental build info
*.tsbuildinfo
