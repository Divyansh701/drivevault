# ==============================================================================
# DriveVault — Environment Configuration Template
# Copy this file to .env and fill in environment-specific values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
DATABASE_URL=mongodb://localhost:27017/drivevault

# ------------------------------------------------------------------------------
# Security & Authentication (JWT Secrets — minimum 32 characters each)
# ------------------------------------------------------------------------------
JWT_SECRET=your-super-secret-access-token-key-change-in-production-min32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production-min32chars
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing Rounds (10-14, default 10)
BCRYPT_ROUNDS=10

# ------------------------------------------------------------------------------
# CORS & Security (Comma-separated list of allowed frontend origins or '*' for wildcard)
# Example for separate production deployment: CORS_ORIGINS=https://my-app.vercel.app,http://localhost:5173
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vite — set VITE_API_URL in production frontend host)
# Local dev: /api/v1 (uses Vite proxy)
# Production: https://your-backend-api-domain.com/api/v1
# ------------------------------------------------------------------------------
VITE_API_URL=/api/v1

